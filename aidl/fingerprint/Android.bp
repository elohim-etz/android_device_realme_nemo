cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.RM6785",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.RM6785.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.RM6785.xml"],
    srcs: [
        "CancellationSignal.cpp",
        "Fingerprint.cpp",
        "LockoutTracker.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.util",
        "vendor.oplus.hardware.biometrics.fingerprint@2.1",
    ],
    header_libs: [
        "libhardware_headers",
    ],
    vendor: true,
}
